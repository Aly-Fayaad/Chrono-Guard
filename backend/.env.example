ENV=dev

# Production database. psycopg 3 is used; plain postgresql:// URLs are also
# accepted and normalised to postgresql+psycopg:// at runtime.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/chronoguard?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Comma-separated public API hosts. Set these to your deployment domains in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Backend-owned operational mission clock (MET / D+ labels and day indexing).
# 24.65 h is the Martian sol; the published circadian equations stay on 24 h.
MISSION_EPOCH=2026-10-30T07:00:00Z
MISSION_DAY_HOURS=24.65

# The integrated crew-health engine is the default. To run without analysis:
# ANALYSIS_ENGINE=app.services.analysis:NullEngine
ANALYSIS_ENGINE=app.ml.crew_health_engine:CrewHealthEngine
