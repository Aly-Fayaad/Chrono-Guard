ENV=dev

# Production database. psycopg 3 is used; plain postgresql:// URLs are also
# accepted and normalised to postgresql+psycopg:// at runtime.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/chronoguard?sslmode=require

# Browser origins allowed to call the API. Use the exact origin (scheme + host,
# NO trailing slash) that the browser sends. Add one entry per deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Optional: allow ephemeral preview deployments instead of listing each one.
# CORS_ORIGIN_REGEX=https://chrono-guard-.*\.vercel\.app

# Comma-separated public API hosts (the Host header allow-list).
# `*.fastapicloud.dev` covers the default FastAPI Cloud domain. Add your custom
# API domain here if you attach one.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.fastapicloud.dev

# Backend-owned operational mission clock (MET / D+ labels and day indexing).
# 24.65 h is the Martian sol; the published circadian equations stay on 24 h.
MISSION_EPOCH=2026-10-30T07:00:00Z
MISSION_DAY_HOURS=24.65

# The integrated crew-health engine is the default. To run without analysis:
# ANALYSIS_ENGINE=app.services.analysis:NullEngine
ANALYSIS_ENGINE=app.ml.crew_health_engine:CrewHealthEngine

# ---------------------------------------------------------------------------
# Production example (set these in the host dashboard, not in a committed file)
# ---------------------------------------------------------------------------
# ENV=prod
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/chronoguard?sslmode=require
# CORS_ORIGINS=https://chrono-guard-hazel.vercel.app
# ALLOWED_HOSTS defaults already include *.fastapicloud.dev and the host from
# FASTAPI_PUBLIC_URL; set it only for a custom API domain.
