# Base URL of the Chrono-Guard backend API (FastAPI).
# Copy this file to .env.local and adjust if the API runs elsewhere.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Demo convenience: create the single demo crew on first load if the database is
# empty. Set to false in a managed deployment where crews are provisioned by an
# administrator.
VITE_AUTO_PROVISION_CREW=false
