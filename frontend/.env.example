# Base URL of the Chrono-Guard backend API (FastAPI), including /api/v1.
# Copy this file to .env.local for development and set the same variable in the
# Vercel project (Settings -> Environment Variables) for production.
# A host-only value (https://api.example.com) is also accepted and gets /api/v1.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Demo convenience (default: enabled). The client creates the single demo crew
# (`crew-demo-01`) on first load if the database is empty. Set to false when
# crews are provisioned by an administrator.
# VITE_AUTO_PROVISION_CREW=false
